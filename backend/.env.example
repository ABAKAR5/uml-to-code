# Copier vers .env (le fichier .env n'est pas sur GitHub) :
#   copy .env.example .env
# Puis remplacez par votre clé Groq (sans guillemets de préférence) :
#   GROQ_API_KEY=gsk_votre_cle_ici
#
# Sur Render : Environment → GROQ_API_KEY (pas de fichier .env)
# Sur Vercel  : Environment → VITE_API_URL=https://votre-backend.onrender.com

GROQ_API_KEY=
